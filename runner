#!/usr/bin/env python3
"""
runner - Development wrapper for psistat
Located in the top-level psistat directory.
Allows running psistat from source for debugging with support for command-line arguments.

Usage:
    ./runner [-b] [-i {1,3,10,60,300}] [-t THRESHOLD_PCT]
    ./runner --help     (show all available options)
"""

import runpy
import sys

if __name__ == '__main__':
    # Set program name but preserve all command-line arguments
    sys.argv[0] = 'psistat'
    # Run the psistat module with alter_sys=True to propagate sys.argv
    runpy.run_module('psistat', run_name='__main__', alter_sys=True)
