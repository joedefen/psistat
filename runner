#!/usr/bin/env python3
"""runner - Development wrapper for psistat.

Located in the top-level psistat directory. Runs psistat from source for
debugging, under the project's editable virtualenv, with support for
command-line arguments.

Usage:
    ./runner [-b] [-i {1,3,10,60,300}] [-t THRESHOLD_PCT]
    ./runner --help     (show all available options)

The per-project environment model puts the package and its dependencies in
<project>/.venv and installs nothing into the shared user site, so this file
re-execs into .venv/bin/python even when it is launched with another
interpreter. It installs nothing and never writes to ~/.local/bin, so it
cannot displace a released psistat.
"""

import os
import runpy
import sys
from pathlib import Path

DEVDIR = Path(__file__).resolve().parent
VENV_PYTHON = DEVDIR / '.venv' / 'bin' / 'python'


def reexec_into_venv():
    """Hand this file to .venv/bin/python unless we are already running there."""
    if Path(sys.executable).resolve() == VENV_PYTHON.resolve():
        return
    if not VENV_PYTHON.is_file():
        sys.exit(f'{DEVDIR}: .venv is missing; build it with "bt penv" and retry')
    os.execv(
        str(VENV_PYTHON),
        [str(VENV_PYTHON), str(Path(__file__).resolve()), *sys.argv[1:]],
    )


if __name__ == '__main__':
    reexec_into_venv()
    runpy.run_module('psistat', run_name='__main__', alter_sys=True)
